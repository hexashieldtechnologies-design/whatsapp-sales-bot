# ==============================================================================
#  WhatsApp AI Sales Bot — environment variables (deployment-time only)
#  Copy to .env and fill in. NOTE: real secrets go in .env (gitignored), never
#  in this example file.
# ==============================================================================

# --- Core ---
PORT=3000
# MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/?appName=Cluster0)
MONGO_URI=

# --- QR pairing page protection ---
# Any visitor who knows this token can view (and pair) your bot's WhatsApp session.
QR_PASSWORD=change-me

# --- Optional runtime defaults (the /settings page overrides these) ---
# These are only used until you save settings via the web page. After that,
# MongoDB is the single source of truth.
AI_PROVIDER=groq

# --- Image hosting for photo-based product adds (optional) ---
# Leave blank to skip storing product images. Supported: "cloudinary" | "s3"
IMAGE_HOST=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
