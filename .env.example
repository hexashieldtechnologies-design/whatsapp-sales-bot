# ==============================================================================
#  WhatsApp AI Assistant — environment variables (deployment-time only)
#  Copy to .env and fill in. NOTE: real secrets go in .env (gitignored), never
#  in this example file.
# ==============================================================================

# --- Core ---
PORT=3000
# MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/?appName=Cluster0)
MONGO_URI=

# --- Admin panel password (default: dev) ---
ADMIN_PASSWORD=change-me

# --- QR pairing page protection ---
QR_PASSWORD=change-me

# --- Optional runtime defaults (the admin panel overrides these) ---
# MongoDB stores settings after first save; these are only initial defaults.
AI_PROVIDER=openrouter
